<Window x:Class="CreateTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo bài thi tự động" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon & Title -->
                <Border Background="#E3F2FD" CornerRadius="8" Width="45" Height="45" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tạo bài thi tự động" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Chọn nhân viên, cấu hình bài thi và tạo đề thi tự động theo lịch" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUploadExcel" Content="📥 Tải file Excel" Click="BtnUploadExcel_Click" Margin="5,0" Padding="10,6" Background="White" BorderBrush="#CBD5E1" Foreground="#0284C7" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button x:Name="BtnDownloadTemplate" Content="📤 Tải mẫu" Click="BtnDownloadTemplate_Click" Margin="5,0" Padding="10,6" Background="White" BorderBrush="#CBD5E1" Foreground="#0284C7" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid View -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="DgEmployees" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="Transparent" BorderBrush="#F1F5F9" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9" RowHeight="45" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="ChkAll" Checked="ChkAll_Checked" Unchecked="ChkAll_Unchecked"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                              Checked="Employee_CheckedChanged" Unchecked="Employee_CheckedChanged"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mã nhân viên" Binding="{Binding EmployeeCode}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Bộ phận" Binding="{Binding Department}" Width="150" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination & Status Bar -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📄" Margin="0,0,5,0"/>
                        <TextBlock x:Name="TxtSelectedCount" Text="Đã chọn 0 nhân viên" Foreground="#334155" FontWeight="Medium"/>
                        <TextBlock Text="  |  " Foreground="#CBD5E1"/>
                        <TextBlock x:Name="TxtTotalCount" Text="Tổng 0 nhân viên" Foreground="#64748B" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- Simple Pagination Mock -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&lt;" Width="30" Height="30" Background="White" BorderBrush="#E2E8F0" Margin="2,0"/>
                        <Button Content="1" Width="30" Height="30" Background="#0284C7" Foreground="White" BorderBrush="#0284C7" FontWeight="Bold" Margin="2,0"/>
                        <Button Content="&gt;" Width="30" Height="30" Background="White" BorderBrush="#E2E8F0" Margin="2,0"/>
                        <TextBlock Text="/ 1" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#64748B"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom Configuration Controls -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,15,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Ngày thi -->
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="📅 Ngày thi" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DpExamDate" Height="35"/>
                </StackPanel>

                <!-- Bài thi (Load từ API) -->
                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="📝 Bài thi" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbExamList" Height="35" DisplayMemberPath="ExamName" SelectedValuePath="ExamId" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Nút Tạo bài thi -->
                <Button x:Name="BtnCreateExam" Grid.Column="2" Content="▶ Tạo bài thi" Click="BtnCreateExam_Click"
                        Background="#0284C7" Foreground="White" FontWeight="Bold" Height="38" 
                        VerticalAlignment="Bottom" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>