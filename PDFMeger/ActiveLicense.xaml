<Window x:Class="PDFMeger.ActiveLicense"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HT-LICENSE-MANAGER" 
        Icon="/images/active.png" Height="680" Width="920"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. Title Bar -->
            <RowDefinition Height="*"/>
            <!-- 2. Main Body -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Footer Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Custom Title Bar -->
        <Border Grid.Row="0" Background="#0B1320" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="#FF5F56" Margin="0,0,8,0"/>
                    <Ellipse Width="12" Height="12" Fill="#FFBD2E" Margin="0,0,8,0"/>
                    <Ellipse Width="12" Height="12" Fill="#27C93F" Margin="0,0,16,0"/>
                    <TextBlock Text="ACTIVE-LICENSE" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#1E293B" CornerRadius="4" Padding="8,2">
                    <TextBlock x:Name="TxtVersion" Text="v1.0.0" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Main Body -->
        <Grid Grid.Row="1" Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header Section -->
                <RowDefinition Height="Auto"/>
                <!-- Status & HWID Cards -->
                <RowDefinition Height="*"/>
                <!-- Input Section -->
                <RowDefinition Height="Auto"/>
                <!-- Notice Banner -->
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="56" Height="56" Background="#1877F2" CornerRadius="16" Margin="0,0,16,0">
                        <TextBlock Text="🔑" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Kích Hoạt Bản Quyền" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Mở khóa đầy đủ tính năng bằng cách nhập mã xác thực" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tab Status Indicator -->
                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="12" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="White" CornerRadius="8" Padding="14,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#000" Opacity="0.05" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡 " Foreground="#1877F2" FontWeight="Bold"/>
                                <TextBlock Text="Kích hoạt License" Foreground="#1877F2" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status & Machine ID Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status Card -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="#FEF3C7" CornerRadius="10" Margin="0,0,12,0">
                            <TextBlock Text="🕒" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TRẠNG THÁI HIỆN TẠI" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtStatus" Text="Dùng thử (Chưa kích hoạt)" FontSize="13" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- HWID Card -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Border Width="40" Height="40" Background="#F1F5F9" CornerRadius="10" Margin="0,0,12,0">
                                <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MÃ MÁY CỦA BẠN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtHwid" Text="Đang lấy mã..." FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Click="BtnCopyHwid_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="12,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 " FontSize="11"/>
                                            <TextBlock Text="Sao chép" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- License Key Input Section -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NHẬP MÃ BẢN QUYỀN " FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="*" Foreground="#EF4444" FontWeight="Bold"/>
                    </StackPanel>

                    <Button Click="BtnPaste_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " Foreground="#1877F2" FontSize="11"/>
                            <TextBlock Text="Dán từ bộ nhớ tạm" Foreground="#1877F2" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Height="110">
                    <TextBox x:Name="TxtLicenseKey" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" 
                             Background="Transparent" Foreground="#0F172A" FontSize="13" VerticalScrollBarVisibility="Auto" 
                             GotFocus="TxtLicenseKey_GotFocus" KeyDown="TxtLicenseKey_KeyDown"/>
                </Border>
            </StackPanel>

            <!-- Info Notice Box -->
            <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ" Foreground="#1D4ED8" FontSize="16" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Top"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#1E40AF" FontSize="12" LineHeight="18">
                        Mã bản quyền được cấp tương ứng với Mã máy duy nhất của thiết bị này. Nếu chưa có mã, Hãy liên hệ với Admin để được cấp mã bản quyền.
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Footer Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="32,16">
            <Grid>
                <!-- Activate Button Right -->
                <Button Click="BtnActivate_Click" HorizontalAlignment="Right" Height="44" Width="210" Background="#1877F2" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ " Foreground="White" FontSize="13"/>
                                    <TextBlock Text="Kích hoạt bản quyền" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>